{
  "name": "design-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Local design canvas for HTML boards: shows docs/design/screens/*.html as boards and edits the source directly, with Claude Code / Codex MCP",
  "license": "MIT",
  "author": "Hyun Park",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemodleo/design-canvas.git"
  },
  "homepage": "https://github.com/nemodleo/design-canvas#readme",
  "bugs": {
    "url": "https://github.com/nemodleo/design-canvas/issues"
  },
  "type": "module",
  "bin": {
    "design-canvas": "bin/server.mjs",
    "design-canvas-mcp": "bin/mcp.mjs"
  },
  "scripts": {
    "start": "node bin/server.mjs",
    "mcp": "node bin/mcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.3",
    "parse5": "^7.3.0",
    "ws": "^8.18.2",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
